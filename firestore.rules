rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function deviceOwner(deviceId) { return signedIn() && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerId == request.auth.uid; }
    function sessionParticipant(sessionId) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participantIds; }
    function safeSignal() {
      return request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'kind', 'payload', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.kind in ['offer', 'answer', 'ice']
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 100000;
    }

    match /devices/{deviceId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid ||
        exists(/databases/$(database)/documents/trustedHelpers/$(deviceId + '_' + request.auth.uid)));
      allow write: if false;
    }
    match /trustedHelpers/{trustId} {
      allow read: if signedIn() && (resource.data.helperUserId == request.auth.uid || deviceOwner(resource.data.parentDeviceId));
      allow write: if false;
    }
    match /pairingInvites/{inviteId} { allow read, write: if false; }
    match /sessionRequests/{requestId} {
      allow read: if signedIn() && (resource.data.helperUserId == request.auth.uid || deviceOwner(resource.data.parentDeviceId));
      allow write: if false;
    }
    match /sessions/{sessionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow write: if false;
      match /signals/{signalId} {
        allow read: if sessionParticipant(sessionId) && resource.data.recipientId == request.auth.uid;
        allow create: if sessionParticipant(sessionId) && safeSignal()
          && request.resource.data.recipientId in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participantIds;
        allow update, delete: if false;
      }
    }
  }
}
