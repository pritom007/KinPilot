{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "outDir": "lib", "rootDir": "src", "strict": true, "esModuleInterop": true,
    "noUncheckedIndexedAccess": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
